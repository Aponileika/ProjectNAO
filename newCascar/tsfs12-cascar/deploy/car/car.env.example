# Copy to a car-specific file, for example deploy/car/turtle.env.
CASCAR_NAME=turtle
# Must match an image already built or loaded on the laptop.
CASCAR_IMAGE=cascar-car:dev
CASCAR_LIDAR_MODEL=a2m8 # a2m8 or a3 depending on lidar model
ROS_DOMAIN_ID=0

# Set to lidar to enable LiDAR, or leave empty to disable it.
COMPOSE_PROFILES=lidar
