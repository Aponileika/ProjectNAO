            <Box name="Kick Attempt" id="7" localization="8" tooltip="Trying basic functions" x="341" y="480">
              <bitmap>media/images/box/box-python-script.png</bitmap>
              <script language="4">
                <content>
                  <![CDATA[class MyClass(GeneratedClass):
    def __init__(self):
        GeneratedClass.__init__(self)
        import threading
        import time  # Import time for delays
        self.lock = threading.Lock()

    def onLoad(self):
        pass

    def onUnload(self):
        pass

    def onInput_onStart(self):
        self.logger.info("Starting Kick Test...")
        self.testKickMotion()
        self.onStopped()  # Signal that the box has finished execution

    def testKickMotion(self):
        try:
            motion = self.session().service("ALMotion")

            # Stabilize NAO's joints
            motion.setStiffnesses("Body", 1.0)  # Ensure joints are stiff for stability

            # Step 1: Lift the knee
            self.logger.info("Lifting the knee...")
            names = ["LKneePitch"]
            angles = [-0.8]  # Bend the knee
            times = [2.0]  # Time to reach the angle
            motion.angleInterpolation(names, angles, times, True)

            # Wait 5 seconds to observe the effect
            time.sleep(5)

            # Step 2: Move the leg forward
            self.logger.info("Moving the leg forward...")
            names = ["LHipPitch"]
            angles = [0.6]  # Move the leg forward
            times = [2.0]
            motion.angleInterpolation(names, angles, times, True)

            # Wait 5 seconds to observe the effect
            time.sleep(5)

            # Step 3: Tilt the foot forward
            self.logger.info("Tilting the foot forward...")
            names = ["LAnklePitch"]
            angles = [0.6]  # Tilt the foot forward
            times = [2.0]
            motion.angleInterpolation(names, angles, times, True)

            # Wait 5 seconds to observe the effect
            time.sleep(5)

            # Reset all joints
            self.logger.info("Resetting joints...")
            names = ["LHipPitch", "LKneePitch", "LAnklePitch"]
            angles = [0.0, 0.0, 0.0]  # Reset angles
            times = [2.0, 2.0, 2.0]
            motion.angleInterpolation(names, angles, times, True)

            # Relax joints after the test
            motion.setStiffnesses("Body", 0.0)
        except Exception as e:
            self.logger.error("testKickMotion(): error %s" % (e))]]>
                </content>
              </script>
